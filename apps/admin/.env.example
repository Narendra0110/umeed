# Copy this file to .env.local and fill in the values. .env.local is never committed.
# The four Firebase values come from the Firebase console: Project settings > Your apps > the Web app > SDK setup.
# They identify the project to the browser; they are not secrets, but keep them out of chat anyway.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the Spring Boot backend runs. Leave empty for http://localhost:8080.
UMEED_API_URL=
