# Settings for the Umeed backend on the server (H02). In H03 this is copied to /etc/umeed/backend.env
# and the placeholders are replaced ON THE SERVER by the project owner. The real file is never committed,
# never copied back to the PC, and never pasted into chat.
#   sudo chown root:umeed /etc/umeed/backend.env && sudo chmod 640 /etc/umeed/backend.env

# PostgreSQL on the same server (H03 creates the database and its user).
UMEED_DB_URL=jdbc:postgresql://localhost:5432/umeed
UMEED_DB_USERNAME=umeed_app
UMEED_DB_PASSWORD=CHANGE_ME_ON_THE_SERVER

# The Firebase service-account key file, copied to the server by the project owner.
UMEED_FIREBASE_CREDENTIALS=/etc/umeed/firebase-key.json

# Optional (these are the defaults).
# UMEED_FIREBASE_PROJECT_ID=umeed-2e018
# UMEED_PHOTOS_DIR=/var/lib/umeed/photos
# UMEED_PORT=8080
