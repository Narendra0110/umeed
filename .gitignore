# ============================================================
# Umeed - root .gitignore
# Keeps secrets, build output and machine-specific files
# out of the repository.
# ============================================================

# ---------- Secrets and credentials (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
*serviceAccount*.json
*service-account*.json
application-local.properties
application-local.yml
application-secrets.properties
application-secrets.yml

# ---------- Java / Maven (backend) ----------
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# ---------- Node / React Native / Expo / Next.js ----------
node_modules/
.expo/
.expo-shared/
dist/
web-build/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.metro-health-check*

# Native build output (generated by Expo prebuild / builds)
*.apk
*.aab
*.ipa
*.hprof
.gradle/
local.properties

# ---------- IDEs and editors ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.cursor/
*.swp

# ---------- Operating system ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- Logs, temp files and test output ----------
logs/
*.log
*.tmp
*.bak
coverage/

# ---------- Local database files and dumps ----------
*.sql.gz
*.dump
pgdata/
